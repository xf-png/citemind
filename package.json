{
  "name": "citemind-evidence-workspace",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "Browser-local Chinese knowledge retrieval with traceable evidence and optional semantic AI",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "benchmark": "node tools/benchmark-retrieval.mjs",
    "build:offline": "node tools/build-offline.mjs",
    "verify:offline": "node tools/build-offline.mjs --check",
    "verify:assets": "node tools/verify-assets.mjs",
    "start": "python -m http.server 4173 --bind 127.0.0.1 --directory dist"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
